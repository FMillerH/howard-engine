*SCENE
SCENE::SPLASH;
SCENE::MAIN;
SCENE::CENTER;
SCENE::LEFT;
SCENE::RIGHT;
SCENE::TOP;

REQUEST! SPLASH     ->  MAIN;

REQUEST! MAIN       ->  SPLASH;
REQUEST! MAIN       ->  CENTER;

REQUEST! CENTER     ->  LEFT;
REQUEST! CENTER     ->  RIGHT;
REQUEST! CENTER     ->  TOP;

REQUEST! LEFT       ->  CENTER;

REQUEST! RIGHT      ->  CENTER;
REQUEST! RIGHT      ->  TOP;